{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!release",
      "!tests/.artifacts",
      "!.plans",
      "!.benchmark-corpus"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@rebase/server/**",
                  "!@rebase/server/package.json",
                  "@rebase/desktop/**"
                ],
                "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/apps/web/features/commit-graph/commit-graph.tsx",
        "src/apps/web/features/commit-graph/components/commit-graph-commit-cells.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": { "noNoninteractiveElementToInteractiveRole": "off" }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
