{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!release",
      "!tests/.artifacts",
      "!.plans",
      "!.benchmark-corpus"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@rebase/server/**",
                  "!@rebase/server/package.json",
                  "@rebase/desktop/**"
                ],
                "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
              },
              {
                "group": ["vitest", "vitest/**"],
                "message": "Import test APIs from vite-plus/test."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/apps/web/features/commit-graph/commit-graph.tsx",
        "src/apps/web/features/commit-graph/components/commit-graph-commit-cells.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/contracts/**", "src/environment-client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": [
                      "#server/**",
                      "#web/**",
                      "#web-ui/**",
                      "#desktop/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/desktop",
                      "@rebase/web/**"
                    ],
                    "message": "Shared contracts and clients cannot depend on application implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "electron",
                      "#*/app/**",
                      "#*/features/**",
                      "#*/adapters/**",
                      "#*/platform/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/web/**",
                      "@rebase/desktop"
                    ],
                    "message": "Domain code depends on contracts, not UI, application composition, or concrete adapters."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/platform/**", "src/apps/web/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": [
                      "#web/app/**",
                      "#web-ui/app/**",
                      "#web/features/**",
                      "#web-ui/features/**",
                      "@rebase/web",
                      "@rebase/web/**"
                    ],
                    "message": "Platform adapters and UI primitives cannot depend on product features or application composition."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/*/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": [
                      "#web/app/**",
                      "#web-ui/app/**",
                      "#server/app/**",
                      "#desktop/app/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/web/**",
                      "@rebase/desktop"
                    ],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/web/features/**",
        "!src/apps/web/features/repository-history/**",
        "!src/apps/web/features/history-storage/**",
        "!src/apps/web/features/history-search/**",
        "!src/apps/web/features/commit-graph/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": [
                      "#web/app/**",
                      "#web-ui/app/**",
                      "#server/app/**",
                      "#desktop/app/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/web/**",
                      "@rebase/desktop"
                    ],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection and the history pipeline."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/web/app/shell/**",
        "src/apps/web/app/workspace/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": ["vitest", "vitest/**"],
                    "message": "Import test APIs from vite-plus/test."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection and the history pipeline."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/desktop/**",
        "src/apps/server/**",
        "!src/apps/*/domain/**",
        "!src/apps/*/features/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rebase/server/**",
                      "!@rebase/server/package.json",
                      "@rebase/desktop/**"
                    ],
                    "message": "Use private #server/* or #desktop/* aliases for internal imports and tests. Cross-package consumers must use the public package entry point."
                  },
                  {
                    "group": ["@rebase/web", "@rebase/web/**"],
                    "message": "Server and desktop code cannot depend on the browser application. Extract a purpose-specific shared client or port."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
