{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!release",
      "!tests/.artifacts",
      "!.plans",
      "!.benchmark-corpus"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/apps/web/features/commit-graph/commit-graph.tsx",
        "src/apps/web/features/commit-graph/components/commit-graph-commit-cells.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#server/**",
                      "#web/**",
                      "#desktop/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/desktop",
                      "@rebase/web/**"
                    ],
                    "message": "Shared contracts and clients cannot depend on application implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/platform/**", "src/apps/web/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#web/app/**",
                      "#web/features/**",
                      "@rebase/web",
                      "@rebase/web/**"
                    ],
                    "message": "Platform adapters and UI primitives cannot depend on product features or application composition."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/*/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#web/app/**",
                      "#server/app/**",
                      "#desktop/app/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/web/**",
                      "@rebase/desktop"
                    ],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/web/features/**",
        "!src/apps/web/features/repository-history/**",
        "!src/apps/web/features/history-search/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "#web/app/**",
                      "#server/app/**",
                      "#desktop/app/**",
                      "@rebase/server",
                      "@rebase/web",
                      "@rebase/web/**",
                      "@rebase/desktop"
                    ],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection and the history pipeline."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/web/app/shell/**",
        "src/apps/web/app/workspace/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection and the history pipeline."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/desktop/**",
        "src/apps/server/**",
        "!src/apps/*/features/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@rebase/web", "@rebase/web/**"],
                    "message": "Server and desktop code cannot depend on the browser application. Extract a purpose-specific shared client or port."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
