{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!native/process-monitor/target",
      "!release",
      "!tests/.artifacts",
      "!.plans",
      "!.benchmark-corpus"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["tests/release-smoke/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/web/features/commit-graph/commit-graph.tsx",
        "src/apps/web/features/commit-graph/components/commit-graph-commit-cells.tsx",
        "src/apps/web/features/commit-graph/components/uncommitted-changes-row.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#web/**", "#desktop/**"],
                    "message": "Shared contracts cannot depend on application implementations."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/server/**", "src/apps/desktop/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#web/**"],
                    "message": "Server and desktop code cannot depend on the browser application."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/server/features/**",
        "src/apps/desktop/features/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#web/**"],
                    "message": "Server and desktop code cannot depend on the browser application."
                  },
                  {
                    "group": ["#server/app/**", "#desktop/app/**"],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#desktop/**"],
                    "message": "The browser application cannot depend on server or desktop code."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#desktop/**"],
                    "message": "The browser application cannot depend on server or desktop code."
                  },
                  {
                    "group": ["#web/app/**"],
                    "message": "Features expose capabilities to application composition and must not depend on it."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/platform/**", "src/apps/web/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#desktop/**"],
                    "message": "The browser application cannot depend on server or desktop code."
                  },
                  {
                    "group": ["#web/app/**", "#web/features/**"],
                    "message": "Platform adapters and UI primitives cannot depend on product features or application composition."
                  },
                  {
                    "group": ["effect", "effect/**"],
                    "message": "Browser features and application composition use TanStack Query and plain TypeScript. Keep Effect in the environment connection."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/app/environment/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#desktop/**"],
                    "message": "The browser application cannot depend on server or desktop code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/platform/environment/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#server/**", "#desktop/**"],
                    "message": "The browser application cannot depend on server or desktop code."
                  },
                  {
                    "group": ["#web/app/**", "#web/features/**"],
                    "message": "Platform adapters and UI primitives cannot depend on product features or application composition."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
