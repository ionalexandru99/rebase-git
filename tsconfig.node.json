{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vite.runtime.config.ts",
    "vite.web.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.main.config.ts",
    "vitest.main-integration.config.ts",
    "vitest.sidecar.config.ts",
    "vitest.server.config.ts",
    "electron-builder.config.js",
    "src/main/**/*",
    "src/electron/**/*",
    "src/server/**/*",
    "src/agent/**/*",
    "src/common/**/*",
    "src/sidecar/**/*",
    "src/shared/**/*"
  ]
}
