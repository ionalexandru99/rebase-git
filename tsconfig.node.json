{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "vite.*.config.ts",
    "vitest.main.config.ts",
    "electron-builder.config.js",
    "src/main/**/*",
    "src/shared/**/*"
  ]
}
