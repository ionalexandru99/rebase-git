{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "#tests-ui/*": ["./ui/*.tsx"],
      "#web/*": ["./../src/apps/web/*.ts", "./../src/apps/web/*.tsx"],
      "#web-ui/*": ["./../src/apps/web/*.tsx"]
    },
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "../playwright*.config.ts",
    "../vitest.config.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ]
}
