{
  "name": "@rebase/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "imports": {
    "#web/*": {
      "rebase-source": "./*.ts",
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "#web-ui/*": {
      "rebase-source": "./*.tsx",
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    }
  },
  "exports": {
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -b",
    "build:web": "vp build",
    "dev": "vp dev --port 4173",
    "preview": "vp preview --port 4173",
    "typecheck": "tsc -b --emitDeclarationOnly"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@pierre/diffs": "1.4.2",
    "@pierre/theme": "2.0.0",
    "@rebase/contracts": "workspace:*",
    "@rebase/environment-client": "workspace:*",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/query-async-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "catalog:",
    "idb-keyval": "6.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
