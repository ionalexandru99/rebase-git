{
  "name": "@rebase/environment-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#environment-client/*": {
      "rebase-source": "./*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "rebase-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly"
  },
  "dependencies": {
    "@rebase/contracts": "workspace:*",
    "effect": "catalog:"
  }
}
