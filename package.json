{
  "name": "rebase",
  "version": "1.0.0",
  "description": "A fast desktop Git GUI built with Electron + TypeScript",
  "main": "./out/main/index.js",
  "author": "",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:playwright-mcp": "electron-vite --rendererOnly --mode playwright-mcp",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:main:integration": "vitest run --config vitest.main-integration.config.ts",
    "test:sidecar": "vitest run --config vitest.sidecar.config.ts",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:smoke": "pnpm build && node scripts/smoke-test.mjs",
    "test:ci": "pnpm test:renderer && pnpm test:main && pnpm test:main:integration && pnpm test:sidecar && pnpm test:e2e",
    "test:coverage": "vitest run --coverage --config vitest.config.ts && vitest run --coverage --config vitest.main.config.ts && vitest run --coverage --config vitest.sidecar.config.ts",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm audit fix",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@effect/platform": "0.96.1",
    "@effect/rpc": "0.75.1",
    "@pierre/diffs": "1.3.0-beta.11",
    "@pierre/theme": "1.1.0",
    "@tanstack/react-query": "5.28.9",
    "@tanstack/react-virtual": "3.5.0",
    "chokidar": "4.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "3.21.3",
    "electron-context-menu": "4.1.2",
    "electron-log": "5.3.0",
    "electron-store": "10.0.0",
    "electron-updater": "6.3.0",
    "electron-window-state": "5.0.3",
    "fuzzysort": "3.1.0",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.3.1",
    "simple-git": "3.36.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@effect/vitest": "0.23.13",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "3.0.5",
    "electron": "41.7.2",
    "electron-builder": "26.6.0",
    "electron-vite": "3.1.0",
    "happy-dom": "20.10.6",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "3.0.5"
  }
}
