{
  "name": "rebase-git",
  "version": "0.0.2",
  "description": "A fast local Git client for the browser and desktop.",
  "author": "Alexandru Ion <ionalexandru99@users.noreply.github.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionalexandru99/rebase-git.git"
  },
  "homepage": "https://github.com/ionalexandru99/rebase-git#readme",
  "bugs": {
    "url": "https://github.com/ionalexandru99/rebase-git/issues"
  },
  "type": "module",
  "bin": {
    "rebase": "./dist/cli.js",
    "rebase-git": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @rebase/server prepare:dist && pnpm --filter @rebase/desktop bundle:preload && pnpm --filter @rebase/desktop copy:assets && pnpm build:web",
    "build:package": "tsc -b src/contracts src/apps/server && node packaging/build.ts",
    "build:web": "pnpm --filter @rebase/web build:web",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "dev:electron": "pnpm build && concurrently --kill-others --success first --names web,desktop \"pnpm dev:web --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:4173 && pnpm --filter @rebase/desktop start -- --renderer-url=http://127.0.0.1:4173\"",
    "dev:server": "node --conditions=rebase-source src/apps/server/cli.ts serve",
    "dev:web": "pnpm --filter @rebase/web dev",
    "test": "pnpm test:unit",
    "test:boundary": "pnpm test:integration && pnpm test:compatibility && pnpm test:e2e",
    "test:compatibility": "vp test run --project compatibility --passWithNoTests",
    "test:e2e": "playwright test",
    "test:integration": "vp test run --project integration --passWithNoTests",
    "test:unit": "vp test run --project unit --passWithNoTests",
    "typecheck": "pnpm --recursive run typecheck && tsc --project packaging/tsconfig.json && tsc --project tests/tsconfig.json",
    "prepack": "pnpm build:package"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.110",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@rebase/contracts": "workspace:*",
    "@rebase/desktop": "workspace:*",
    "@rebase/server": "workspace:*",
    "@rebase/web": "workspace:*",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "drizzle-kit": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wait-on": "9.1.0"
  }
}
