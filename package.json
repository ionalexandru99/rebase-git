{
  "name": "rebase",
  "version": "1.0.0",
  "description": "A fast desktop Git GUI built with Electron + TypeScript",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ci": "vitest run && vitest run --config vitest.main.config.ts && playwright test",
    "audit": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm audit fix",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@effect/platform": "0.96.1",
    "@effect/platform-browser": "0.76.0",
    "@radix-ui/react-slot": "1.2.4",
    "chokidar": "4.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "effect": "3.21.2",
    "electron-context-menu": "4.1.2",
    "electron-log": "5.3.0",
    "electron-store": "10.0.0",
    "electron-updater": "6.3.0",
    "electron-window-state": "5.0.3",
    "lucide-react": "1.16.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-resizable-panels": "4.11.1",
    "simple-git": "3.36.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.8.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "41.2.1",
    "electron-builder": "26.6.0",
    "electron-vite": "3.1.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "3.0.5"
  }
}
