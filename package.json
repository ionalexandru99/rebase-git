{
  "name": "rebase-git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#web/*": "./src/apps/web/*.ts"
  },
  "bin": {
    "rebase": "./src/apps/server/dist/cli.js"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @rebase/server copy:migrations && pnpm --filter @rebase/desktop bundle:preload && pnpm build:web",
    "build:web": "pnpm --filter @rebase/web build:web",
    "check": "biome check .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "dev:electron": "pnpm build && concurrently --kill-others --success first --names web,desktop \"pnpm dev:web --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:4173 && pnpm --filter @rebase/desktop start -- --renderer-url=http://127.0.0.1:4173\"",
    "dev:server": "node --conditions=rebase-source src/apps/server/cli.ts serve",
    "dev:web": "pnpm --filter @rebase/web dev",
    "test": "pnpm test:unit",
    "test:boundary": "pnpm test:integration && pnpm test:compatibility && pnpm test:e2e",
    "test:compatibility": "vp test run --project compatibility --passWithNoTests",
    "test:e2e": "playwright test",
    "test:integration": "vp test run --project integration --passWithNoTests",
    "test:unit": "vp test run --project unit --passWithNoTests",
    "typecheck": "pnpm --recursive run typecheck && tsc --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@rebase/contracts": "workspace:*",
    "@rebase/desktop": "workspace:*",
    "@rebase/server": "workspace:*",
    "@rebase/web": "workspace:*",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wait-on": "9.1.0"
  }
}
