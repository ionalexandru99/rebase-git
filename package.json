{
  "name": "rebase-git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "biome check .",
    "test": "pnpm test:unit",
    "test:boundary": "pnpm test:integration && pnpm test:compatibility && pnpm test:e2e",
    "test:compatibility": "vitest run --project compatibility --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "typecheck": "pnpm --recursive run typecheck && tsc --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
